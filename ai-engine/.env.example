LIFEINBOX_LLM_API_KEY=
LIFEINBOX_LLM_MODEL=
LIFEINBOX_EMBEDDING_MODEL=
LIFEINBOX_RERANK_MODEL=
LIFEINBOX_LLM_BASE_URL=
# Alibaba Cloud Model Studio / Beijing 示例：
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
LIFEINBOX_RERANK_BASE_URL=
LIFEINBOX_LLM_TIMEOUT_SECONDS=20
LIFEINBOX_RERANK_TIMEOUT_SECONDS=8
# Spring Boot Hybrid 开关；应在启动 server 的环境中设置。
LIFEINBOX_RERANK_ENABLED=false
LIFEINBOX_VECTOR_STORE_ENABLED=false
LIFEINBOX_QDRANT_URL=http://127.0.0.1:6333
LIFEINBOX_QDRANT_COLLECTION=lifeinbox_items
LIFEINBOX_QDRANT_API_KEY=
LIFEINBOX_QDRANT_TIMEOUT_SECONDS=5
